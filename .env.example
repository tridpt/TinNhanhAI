# Copy this file to .env and fill in your values

# App
APP_NAME=TinNhanh AI
HOST=127.0.0.1
PORT=5055
DEBUG=1

# OpenAI (optional - app falls back to non-AI summaries if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cache TTLs (seconds)
NEWS_REFRESH_SECONDS=900
PRICE_REFRESH_SECONDS=300
DASHBOARD_REFRESH_SECONDS=600
SEARCH_REFRESH_SECONDS=300

# Search
WEB_SEARCH_MAX_RESULTS=6
PRODUCT_SEARCH_MAX_RESULTS=5
