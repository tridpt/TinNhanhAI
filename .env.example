# Copy this file to .env and fill in your values

# App
APP_NAME=TinNhanh AI
HOST=127.0.0.1
PORT=5055
DEBUG=1

# AI provider (set one or both — Gemini is preferred if both are set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Cache TTLs (seconds)
NEWS_REFRESH_SECONDS=900
PRICE_REFRESH_SECONDS=300
DASHBOARD_REFRESH_SECONDS=600
SEARCH_REFRESH_SECONDS=300

# Search
WEB_SEARCH_MAX_RESULTS=6
PRODUCT_SEARCH_MAX_RESULTS=5

# Production server
TINNHANH_PROD=0
ASK_RATE_LIMIT_PER_MINUTE=20

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_KEYWORDS=
TELEGRAM_POLL_SECONDS=600
